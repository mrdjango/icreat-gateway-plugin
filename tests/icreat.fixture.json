            "metadata": {
              "generate_audio": false
            }
          }
        }
      ],
      "expected": {
        "url": "https://api.icreat.ai/v1/task/submit/bytedance/seedance-2-0",
        "method": "POST",
        "headers": {
          "Accept": "application/json",
          "Authorization": "Bearer k",
          "Content-Type": "application/json"
        },
        "body": {
          "content": [
            {
              "type": "text",
              "text": "p"
            },
            {
              "type": "image_url",
              "image_url": {
                "url": "https://cdn.example/a.png"
              },
              "role": "first_frame"
            }
          ],
          "resolution": "1080p",
          "ratio": "adaptive",
          "duration": 5,
          "watermark": false,
          "generate_audio": false
        },
        "action": "image_to_video"
      }
    },
    {
      "name": "seedance reference video is a priced input",
      "hook": "extractUsage",
      "args": [
        {
          "model": "bytedance/seedance-2-5",
          "requestBody": {
            "prompt": "",
            "seconds": 8,
            "metadata": {
              "resolution": "480p",
              "content": [
                {
                  "type": "text",
                  "text": "edit"
                },
                {
                  "type": "video_url",
                  "video_url": {
                    "url": "https://cdn.example/v.mp4"
                  },
                  "role": "reference_video"
                }
              ]
            }
          }
        }
      ],
      "expected": {
        "seconds": 8,
        "resolution": "480p",
        "video_input": "video",
        "upstream_cost": 0
      }
    },
