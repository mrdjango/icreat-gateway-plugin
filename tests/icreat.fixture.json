    {
      "name": "seedance single image is the first frame",
      "hook": "buildSubmitRequest",
      "args": [
        {
          "model": "bytedance/seedance-2-0",
          "baseUrl": "https://api.icreat.ai",
          "apiKey": "k",
          "requestBody": {
            "prompt": "p",
